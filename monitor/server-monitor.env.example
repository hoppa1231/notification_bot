MONITOR_NAME=vpn
TARGET_HOST=85.159.228.153
TCP_CHECKS=20050:ssh,443:xray-443,444:xray-444,445:xray-445
HTTP_CHECKS=
MONITOR_INTERVAL_SECONDS=60
MONITOR_FAIL_THRESHOLD=3
MONITOR_RECOVER_THRESHOLD=2
MONITOR_STATE_FILE=/var/lib/server-monitor/state.json
MONITOR_DEPLOY_INFO=vpn server 85.159.228.153

# Preferred for monitoring a different server. Requires Telegram egress from the monitor host.
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me

# Temporary fallback if Telegram is unavailable from the monitor host.
# This cannot alert when the notification API host itself is down.
NOTIFY_API_URL=http://185.58.204.104:2005/notify
NOTIFY_API_TOKEN=replace_me
